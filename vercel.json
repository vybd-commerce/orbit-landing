{
    "redirects": [
        {
            "source": "/:path(outside-context|outsidecontext|Outside-Context|OutsideContext)/",
            "destination": "/outside-context",
            "permanent": true
        },
        {
            "source": "/outside-context/community/",
            "destination": "/outside-context/community",
            "permanent": true
        },
        {
            "source": "/:path(Outside-Context|OutsideContext|outsidecontext)",
            "destination": "/outside-context",
            "permanent": true
        },
        { "source": "/fund-raise", "destination": "/fundraise", "permanent": true },
        { "source": "/:path(askinkind|ask-in-kind)", "destination": "https://askinkind.org", "permanent": false }
    ],
    "headers": [
        {
            "source": "/:path(fundraise|fund-raise|fund-raise\\.html)",
            "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
        }
    ],
    "rewrites": [
        {
            "source": "/us",
            "destination": "/us-en.html"
        },
        {
            "source": "/borderless",
            "destination": "/home.html"
        },
        {
            "source": "/:locale(zh|ko|ja|fr|es)/us",
            "destination": "/us.html"
        },
        {
            "source": "/enterprise",
            "destination": "/enterprise.html"
        },
        {
            "source": "/product",
            "destination": "/product.html"
        },
        {
            "source": "/:locale(zh|ko|ja|fr|es)/product",
            "destination": "/product.html"
        },
        {
            "source": "/lab",
            "destination": "/lab.html"
        },
        {
            "source": "/:locale(zh|ko|ja|fr|es)/lab",
            "destination": "/lab.html"
        },
        {
            "source": "/case-studies",
            "destination": "/case-studies.html"
        },
        {
            "source": "/:locale(zh|ko|ja|fr|es)/case-studies",
            "destination": "/case-studies.html"
        },
        {
            "source": "/ecosystem",
            "destination": "/ecosystem.html"
        },
        {
            "source": "/rainmaker",
            "destination": "/rainmaker.html"
        },
        {
            "source": "/:locale(zh|ko)/rainmaker",
            "destination": "/rainmaker.html"
        },
        {
            "source": "/test-drop",
            "destination": "/test-drop.html"
        },
        {
            "source": "/fundraise",
            "destination": "/fund-raise.html"
        },
        {
            "source": "/signup",
            "destination": "/signup.html"
        },
        {
            "source": "/outside-context/community",
            "destination": "/outside-context-community.html"
        },
        {
            "source": "/:path(outside-context|outsidecontext)",
            "destination": "/outside-context.html"
        },
        {
            "source": "/essay",
            "destination": "/essay.html"
        },
        {
            "source": "/waitlist",
            "destination": "/waitlist.html"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}
